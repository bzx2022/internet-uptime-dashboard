<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    ProductCode is pinned per release so rebuilding the same version upgrades
    in place. Give it a new GUID whenever ProductVersion changes.
  -->
  <Package Name="Internet Uptime Tracker"
           Manufacturer="Internet Uptime Tracker"
           Version="$(var.ProductVersion)"
           ProductCode="2F5A9C1E-7B3D-4E8A-9C6B-1D4E7A2B8C30"
           UpgradeCode="7E1B0F0A-5D7C-4C7C-9C7F-2F4B5A6C8D91"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Internet Uptime Tracker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Local internet uptime tracking service and dashboard." />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="MainFeature" Title="Internet Uptime Tracker" Level="1">
      <ComponentGroupRef Id="TrackerComponents" />
      <ComponentGroupRef Id="DashboardComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!--
      The original tracker was installed by hand at D:\InternetUptimeTracker.
      Windows won't let a new service with the same name be created while that
      one exists, so stop/kill/delete it before InstallServices creates ours.
      The action is best-effort and only runs on a fresh MSI install.
    -->
    <CustomAction Id="CleanupLegacyTrackerService"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c &quot;sc stop InternetUptimeTracker &gt;nul 2&gt;&amp;1 &amp; taskkill /f /im InternetUptimeTracker.exe &gt;nul 2&gt;&amp;1 &amp; sc delete InternetUptimeTracker &gt;nul 2&gt;&amp;1 &amp; ping -n 4 127.0.0.1 &gt;nul&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CleanupLegacyTrackerService"
              Before="InstallServices"
              Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Internet Uptime Tracker">
        <Directory Id="TrackerFolder" Name="Tracker" />
        <Directory Id="DashboardFolder" Name="Dashboard" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Internet Uptime Tracker" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="TrackerComponents" Directory="TrackerFolder">

      <Files Include="$(var.TrackerPublishDir)\**">
        <Exclude Files="$(var.TrackerPublishDir)\InternetUptimeTracker.exe" />
        <Exclude Files="$(var.TrackerPublishDir)\appsettings.json" />
      </Files>

      <Component Id="TrackerServiceComponent" Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D">
        <File Id="TrackerServiceExe"
              Source="$(var.TrackerPublishDir)\InternetUptimeTracker.exe"
              KeyPath="yes" />
        <ServiceInstall Id="TrackerServiceInstall"
                        Name="InternetUptimeTracker"
                        DisplayName="Internet Uptime Tracker"
                        Description="Monitors internet connectivity and records outages."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <ServiceDependency Id="Tcpip" />
        </ServiceInstall>
        <ServiceControl Id="TrackerServiceControl"
                        Name="InternetUptimeTracker"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="TrackerConfigComponent" Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E" NeverOverwrite="yes">
        <File Id="TrackerConfigFile"
              Source="$(var.TrackerPublishDir)\appsettings.json"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DashboardComponents" Directory="DashboardFolder">

      <Files Include="$(var.DashboardPublishDir)\**">
        <Exclude Files="$(var.DashboardPublishDir)\InternetUptimeTracker.Dashboard.exe" />
        <Exclude Files="$(var.DashboardPublishDir)\appsettings.json" />
      </Files>

      <Component Id="DashboardServiceComponent" Guid="C3D4E5F6-A7B8-4C9D-0E1F-2A3B4C5D6E7F">
        <File Id="DashboardServiceExe"
              Source="$(var.DashboardPublishDir)\InternetUptimeTracker.Dashboard.exe"
              KeyPath="yes" />
        <ServiceInstall Id="DashboardServiceInstall"
                        Name="InternetUptimeTrackerDashboard"
                        DisplayName="Internet Uptime Tracker Dashboard"
                        Description="Serves the local internet uptime dashboard on http://127.0.0.1:8787."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <ServiceDependency Id="Tcpip" />
        </ServiceInstall>
        <ServiceControl Id="DashboardServiceControl"
                        Name="InternetUptimeTrackerDashboard"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="DashboardConfigComponent" Guid="D4E5F6A7-B8C9-4D0E-1F2A-3B4C5D6E7F80" NeverOverwrite="yes">
        <File Id="DashboardConfigFile"
              Source="$(var.DashboardPublishDir)\appsettings.json"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="INSTALLFOLDER">
      <Component Id="ShortcutComponent" Guid="E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8091">
        <File Id="DashboardUrlFile"
              Source="assets\Internet Uptime Dashboard.url"
              Name="Internet Uptime Dashboard.url"
              KeyPath="yes" />

        <Shortcut Id="DesktopDashboardShortcut"
                  Directory="DesktopFolder"
                  Name="Internet Uptime Dashboard"
                  Description="Open the local internet uptime dashboard"
                  Target="[#DashboardUrlFile]"
                  WorkingDirectory="INSTALLFOLDER" />

        <Shortcut Id="StartMenuDashboardShortcut"
                  Directory="AppMenuFolder"
                  Name="Internet Uptime Dashboard"
                  Description="Open the local internet uptime dashboard"
                  Target="[#DashboardUrlFile]"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
